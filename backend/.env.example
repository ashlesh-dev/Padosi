# Copy this file to ".env" (same folder) and fill in YOUR Supabase values.
# ".env" is git-ignored. Never commit real passwords.
# Supabase Dashboard > Connect > Session pooler (or Project Settings > Database)
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password

# Secret used to sign JWTs: at least 32 random characters (e.g. run: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N'))
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Optional:
# JWT_EXPIRATION_MINUTES=1440
# CORS_ALLOWED_ORIGINS=http://localhost:5173
